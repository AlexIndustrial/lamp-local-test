# Tuya IoT Platform (Cloud) - only needed to fetch the Local Key
TUYA_API_REGION=eu
TUYA_API_KEY=replace_with_access_id
TUYA_API_SECRET=replace_with_access_secret
TUYA_DEVICE_ID=replace_with_device_id

# Local control (after fetch_keys.py / qr_keys.py)
TUYA_LOCAL_KEY=
TUYA_LOCAL_IP=
TUYA_LOCAL_VERSION=3.5
# White bulb mapping: 20=power, 21=mode, 22=brightness 10-1000, 23=temperature 0-1000, 24=color
